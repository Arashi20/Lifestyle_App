SECRET_KEY=change-me
DATABASE_URL=postgresql://user:password@localhost:5432/skincare_tracker

# Only needed locally on Windows if Tesseract isn't on PATH after installing
# (the UB-Mannheim installer doesn't add itself to PATH):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Login gate — set both via `flask set-password` rather than by hand.
# AUTH_USERNAME=
# AUTH_PASSWORD_HASH=
